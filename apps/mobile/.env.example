# Copy this file to .env for local builds. The Firebase project itself comes from google-services.json (put it in apps/mobile/)
# and EXPO_PUBLIC_FIREBASE_ENABLED=1 turns the real Firebase features on. Leave both out to run the local demo in Expo Go.
EXPO_PUBLIC_FIREBASE_ENABLED=
# Authentication > Sign-in method > Google > Web SDK configuration > Web client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Public web page with the privacy policy and terms
EXPO_PUBLIC_PRIVACY_URL=
# Help & support: how people reach the admin (email and/or WhatsApp number with country code, digits only)
EXPO_PUBLIC_ADMIN_EMAIL=
EXPO_PUBLIC_ADMIN_WHATSAPP=

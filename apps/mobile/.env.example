# Copy this file to .env and fill in the values from your Firebase project (Project settings > Your apps > Android app).
# Leave them empty to run in local demo mode (Expo Go): no real sign-in, communities or push.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Authentication > Sign-in method > Google > Web SDK configuration > Web client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

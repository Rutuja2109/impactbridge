rules_version = '2';
// Security rules for GoodNeighbour. Deploy with: firebase deploy --only firestore:rules
// Organisations are marked verified, and posts approved, ONLY by an admin (a person with a document in /admins/{uid}),
// from the Admin screen in the app or the Firebase console. Other people can never set those fields.
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in, and (for email + password accounts) the email address has been verified through the link we send.
    function signedIn() { return request.auth != null && (request.auth.token.firebase.sign_in_provider != 'password' || request.auth.token.email_verified == true); }
    // An admin is a person with a document in /admins/{their uid}, created by hand in the Firebase console.
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isVerifiedOrg() { return signedIn() && get(/databases/$(database)/documents/orgs/$(request.auth.uid)).data.verified == true; }

    // Admin marker: a person can only check whether they themselves are an admin.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    // A person's own profile and push token.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();   // the dashboard counts accounts
    }

    // Organisation verification requests. 'verified' and 'status' are admin-only.
    match /orgs/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.verified == false
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.verified == resource.data.verified
        && request.resource.data.status == resource.data.status;
      allow update: if isAdmin();
    }

    // Communities: anyone signed in can read; only verified organisations can create or edit their own.
    match /communities/{cid} {
      allow read: if signedIn();
      allow create: if (isVerifiedOrg() || isAdmin()) && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.whatsapp.matches('https://chat\\.whatsapp\\.com/.+');
      allow update, delete: if (isVerifiedOrg() && resource.data.ownerId == request.auth.uid) || isAdmin();

      // A person joins by writing their own member document; the owner can read the list.
      match /members/{uid} {
        allow create, delete: if signedIn() && request.auth.uid == uid;
        allow read: if signedIn() && (request.auth.uid == uid
          || get(/databases/$(database)/documents/communities/$(cid)).data.ownerId == request.auth.uid);
      }
    }

    // Posts: saved as 'pending'; only an admin (Firebase console) can approve them. Everyone signed in can read approved posts.
    match /posts/{pid} {
      allow read: if signedIn() && (resource.data.status == 'approved' || resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if (signedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.status == 'pending') || isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      // An admin edits anything (approve, reject); the author can only update the confirmed-money totals (see donations below).
      allow update: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['received', 'donors']));

      // The author's private contact: only the author can read or write it.
      match /private/{doc} {
        allow read, write: if signedIn() && get(/databases/$(database)/documents/posts/$(pid)).data.ownerId == request.auth.uid;
        allow read, delete: if isAdmin();
        allow delete: if signedIn() && get(/databases/$(database)/documents/posts/$(pid)).data.ownerId == request.auth.uid;
      }
      // Photos: the author adds them; everyone signed in sees photos of the post, but photos of documents only the author and admins.
      match /files/{fid} {
        allow delete: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/posts/$(pid)).data.ownerId == request.auth.uid);
        allow create: if signedIn() && get(/databases/$(database)/documents/posts/$(pid)).data.ownerId == request.auth.uid;
        allow read: if signedIn() && (resource.data.field != 'docs'
          || get(/databases/$(database)/documents/posts/$(pid)).data.ownerId == request.auth.uid || isAdmin());
      }
      // Payments people report for a fundraiser: the donor writes one as 'pledged'; the author or an admin settles it.
      match /donations/{did} {
        allow delete: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/posts/$(pid)).data.ownerId == request.auth.uid);
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pledged'
          && request.resource.data.amount is number && request.resource.data.amount >= 10 && request.resource.data.amount <= 100000
          && get(/databases/$(database)/documents/posts/$(pid)).data.status == 'approved';
        allow read: if signedIn() && (resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(pid)).data.ownerId == request.auth.uid || isAdmin());
        allow update: if signedIn() && (get(/databases/$(database)/documents/posts/$(pid)).data.ownerId == request.auth.uid || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      }
      // Payments the organiser has confirmed, shown on the fundraiser page: the organiser (or an admin) writes them, everyone reads.
      match /supporters/{sid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && (get(/databases/$(database)/documents/posts/$(pid)).data.ownerId == request.auth.uid || isAdmin());
      }
      // Offers of help: the person writes their own; the post's author can read them.
      match /responses/{uid} {
        allow delete: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/posts/$(pid)).data.ownerId == request.auth.uid);
        allow create: if signedIn() && request.auth.uid == uid;
        allow read: if signedIn() && (request.auth.uid == uid || get(/databases/$(database)/documents/posts/$(pid)).data.ownerId == request.auth.uid || isAdmin());
      }
    }

    // Counts for the admin dashboard across every post's offers of help, payments and community members.
    match /{path=**}/responses/{x} { allow read: if isAdmin(); }
    match /{path=**}/donations/{x} { allow read: if isAdmin(); }
    match /{path=**}/members/{x} { allow read: if isAdmin(); }

    // Reports about posts or communities: anyone signed in can file one; only admins (console) can read them.
    match /reports/{rid} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      allow read: if isAdmin();
    }

    // The offers of help a person has made (behind their badge and certificate): theirs alone.
    match /users/{uid}/helps/{pid} {
      allow read, create, delete: if signedIn() && request.auth.uid == uid;
    }

    // A donor's own copy of each payment they reported, so they can follow it. The organiser (or an admin) can only change its status.
    match /users/{uid}/gives/{gid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.status == 'pledged'
        && request.resource.data.amount is number && request.resource.data.amount >= 10 && request.resource.data.amount <= 100000;
      allow read: if isAdmin();
      allow update: if signedIn() && (isAdmin() || get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.ownerId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt']);
    }

    // In-app notifications are written by the Cloud Function only; the person can read and mark their own.
    match /users/{uid}/notifications/{nid} {
      allow read, update, delete: if signedIn() && request.auth.uid == uid;
    }
  }
}

# Copy to backend/.env and fill in. Everything except JWT_SECRET (in production) is optional.

APP_ENV=development            # set to "production" when deploying (enforces JWT_SECRET, secure cookies)
PUBLIC_URL=http://localhost:8000
JWT_SECRET=                    # long random string; generated automatically in development
CURRENCY=INR
MAX_UPLOAD_MB=10
# DATA_DIR=./data              # database + uploads live here

# First administrator (created on startup if no user has this email yet)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- AI structuring of community needs (pick one; first configured wins unless AI_PROVIDER is set)
AI_PROVIDER=                   # anthropic | gemini | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro
OPENAI_API_KEY=                # also enables Whisper voice transcription and semantic search
OPENAI_MODEL=gpt-5
# Embeddings for semantic search: OpenAI (preferred) or Gemini
OPENAI_EMBED_MODEL=text-embedding-3-small
GEMINI_EMBED_MODEL=text-embedding-004
WHISPER_MODEL=whisper-1

# --- Email notifications (optional)
RESEND_API_KEY=
EMAIL_FROM=ImpactBridge <notifications@yourdomain.org>

# --- Android app (Trusted Web Activity) and support contact
SUPPORT_EMAIL=                 # shown on /privacy and /delete-account; required for the Play Store listing
ANDROID_PACKAGE_NAME=          # e.g. org.impactbridge.app
ANDROID_CERT_SHA256=           # Play Console > App integrity > App signing key SHA-256 (comma-separate several)

# --- Phone sign-in codes (optional; without it, development prints codes in the console)
SMS_PROVIDER=                  # msg91 | twilio
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=             # DLT-approved OTP template containing ##OTP##
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Push notifications (optional): python -m app.cli vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                 # mailto:you@yourdomain.org
